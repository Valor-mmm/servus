{
  "nodeModulesDir": "manual",
  "unstable": ["kv"],
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check **/*.ts **/*.tsx",
    "dev": "deno run -A --env-file=.env --watch=static/,routes/ dev.ts",
    "build": "deno run -A dev.ts build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update .",
    "test": "deno test --allow-env --allow-read --allow-net --permit-no-files tests/unit tests/integration",
    "e2e": "deno task build && node_modules/.bin/playwright test",
    "lint": "deno lint .",
    "fmt": "deno fmt ."
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "imports": {
    "@/": "./",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@playwright/test": "npm:@playwright/test@^1.44.0",
    "hash-wasm": "npm:hash-wasm@4.12.0",
    "@std/assert": "jsr:@std/assert@^1.0.16"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ]
  }
}
