# 64-char hex string (32 bytes). Generate with: openssl rand -hex 32
# REQUIRED — the app will refuse to start without this.
SERVUS_SESSION_KEY=REPLACE_WITH_OUTPUT_OF__openssl_rand_-hex_32

# JSON array of users created on first boot (skipped if username already exists).
# REQUIRED — without this no one can log in.
# Change these passwords before deploying!
SERVUS_SEED_USERS=[{"username":"monster","password":"change-me-1"},{"username":"maus","password":"change-me-2"}]

# ── Cloudflare R2 (photo storage) ─────────────────────────────────────────────
# See docs/decisions/cloudflare-r2-setup.md for setup instructions.
# REQUIRED when photo upload/display features are used.
R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET=REPLACE_WITH_BUCKET_NAME
R2_PUBLIC_URL_BASE=https://ACCOUNT_ID.r2.cloudflarestorage.com/BUCKET_NAME
